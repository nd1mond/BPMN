<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_asis" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_asis"><bpmn:participant id="Pool_asis" name="Аренда оборудования: AS-IS" processRef="Process_asis"/></bpmn:collaboration>
<bpmn:process id="Process_asis" isExecutable="false"><bpmn:laneSet id="LS_asis">
<bpmn:lane id="Lane_asis_0" name="Клиент"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_asis_1" name="Команда сервиса"><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>e3</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Нужно оборудование для мероприятия"><bpmn:outgoing>f_s_t1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="t1" name="Написать в любой мессенджер"><bpmn:incoming>f_s_t1</bpmn:incoming><bpmn:outgoing>f_t1_t2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t2" name="Заявка попадает в один из чатов (Telegram, WhatsApp, VK)"><bpmn:incoming>f_t1_t2</bpmn:incoming><bpmn:outgoing>f_t2_g1</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g1" name="Заявку заметили вовремя?"><bpmn:incoming>f_t2_g1</bpmn:incoming><bpmn:outgoing>f_g1_e1</bpmn:outgoing><bpmn:outgoing>f_g1_t3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e1" name="Клиент ушёл без ответа"><bpmn:incoming>f_g1_e1</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="t3" name="Ответить вручную, уточнить детали в переписке"><bpmn:incoming>f_g1_t3</bpmn:incoming><bpmn:outgoing>f_t3_t4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t4" name="Подобрать оборудование и посчитать цену вручную"><bpmn:incoming>f_t3_t4</bpmn:incoming><bpmn:outgoing>f_t4_t5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t5" name="Рассмотреть предложение"><bpmn:incoming>f_t4_t5</bpmn:incoming><bpmn:outgoing>f_t5_g2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g2" name="Согласен?"><bpmn:incoming>f_t5_g2</bpmn:incoming><bpmn:outgoing>f_g2_e2</bpmn:outgoing><bpmn:outgoing>f_g2_t6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e2" name="Отказ"><bpmn:incoming>f_g2_e2</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="t6" name="Договор, доставка и возврат без единого порядка"><bpmn:incoming>f_g2_t6</bpmn:incoming><bpmn:outgoing>f_t6_e3</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e3" name="Заказ выполнен"><bpmn:incoming>f_t6_e3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f_s_t1" sourceRef="s" targetRef="t1"/>
<bpmn:sequenceFlow id="f_t1_t2" sourceRef="t1" targetRef="t2"/>
<bpmn:sequenceFlow id="f_t2_g1" sourceRef="t2" targetRef="g1"/>
<bpmn:sequenceFlow id="f_g1_e1" name="Нет" sourceRef="g1" targetRef="e1"/>
<bpmn:sequenceFlow id="f_g1_t3" name="Да" sourceRef="g1" targetRef="t3"/>
<bpmn:sequenceFlow id="f_t3_t4" sourceRef="t3" targetRef="t4"/>
<bpmn:sequenceFlow id="f_t4_t5" sourceRef="t4" targetRef="t5"/>
<bpmn:sequenceFlow id="f_t5_g2" sourceRef="t5" targetRef="g2"/>
<bpmn:sequenceFlow id="f_g2_e2" name="Нет" sourceRef="g2" targetRef="e2"/>
<bpmn:sequenceFlow id="f_g2_t6" name="Да" sourceRef="g2" targetRef="t6"/>
<bpmn:sequenceFlow id="f_t6_e3" sourceRef="t6" targetRef="e3"/>
<bpmn:textAnnotation id="n1"><bpmn:text>Проблема: заявки разбросаны по разным чатам и теряются</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_n1" sourceRef="t2" targetRef="n1"/>
<bpmn:textAnnotation id="n2"><bpmn:text>Проблема: нет ответственного и единого порядка, ответ занимает много времени</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_n2" sourceRef="t4" targetRef="n2"/>
<bpmn:textAnnotation id="n3"><bpmn:text>Проблема: этапы зависят от того, кто взял заявку</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_n3" sourceRef="t6" targetRef="n3"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Dia_asis"><bpmndi:BPMNPlane id="Plane_asis" bpmnElement="Collab_asis">
