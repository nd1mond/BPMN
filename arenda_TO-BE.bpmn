<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_tobe" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_tobe"><bpmn:participant id="Pool_tobe" name="Аренда оборудования: TO-BE" processRef="Process_tobe"/></bpmn:collaboration>
<bpmn:process id="Process_tobe" isExecutable="false"><bpmn:laneSet id="LS_tobe">
<bpmn:lane id="Lane_tobe_0" name="Клиент"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_tobe_1" name="Продажи"><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>tr</bpmn:flowNodeRef><bpmn:flowNodeRef>er</bpmn:flowNodeRef><bpmn:flowNodeRef>t11</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_tobe_2" name="Логистика"><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef><bpmn:flowNodeRef>t10</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_tobe_3" name="Сопровождение"><bpmn:flowNodeRef>t9</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Нужно оборудование для мероприятия"><bpmn:outgoing>f_s_t1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="t1" name="Оставить заявку в удобном канале"><bpmn:incoming>f_s_t1</bpmn:incoming><bpmn:outgoing>f_t1_t2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t2" name="Внести заявку в единый журнал, назначить ответственного"><bpmn:incoming>f_t1_t2</bpmn:incoming><bpmn:outgoing>f_t2_t3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t3" name="Уточнить задачу: формат мероприятия, дата, бюджет"><bpmn:incoming>f_t2_t3</bpmn:incoming><bpmn:outgoing>f_t3_t4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t4" name="Подобрать готовый комплект и отправить предложение"><bpmn:incoming>f_t3_t4</bpmn:incoming><bpmn:incoming>f_g1_t4</bpmn:incoming><bpmn:outgoing>f_t4_t5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t5" name="Рассмотреть предложение"><bpmn:incoming>f_t4_t5</bpmn:incoming><bpmn:outgoing>f_t5_g1</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g1" name="Подходит?"><bpmn:incoming>f_t5_g1</bpmn:incoming><bpmn:outgoing>f_g1_t6</bpmn:outgoing><bpmn:outgoing>f_g1_tr</bpmn:outgoing><bpmn:outgoing>f_g1_t4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t6" name="Подписать договор и внести предоплату"><bpmn:incoming>f_g1_t6</bpmn:incoming><bpmn:outgoing>f_t6_t7</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="tr" name="Зафиксировать причину отказа в журнале"><bpmn:incoming>f_g1_tr</bpmn:incoming><bpmn:outgoing>f_tr_er</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="er" name="Отказ"><bpmn:incoming>f_tr_er</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="t7" name="Зарезервировать оборудование, проверить состояние"><bpmn:incoming>f_t6_t7</bpmn:incoming><bpmn:outgoing>f_t7_t8</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t8" name="Доставить и передать по акту"><bpmn:incoming>f_t7_t8</bpmn:incoming><bpmn:outgoing>f_t8_t9</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t9" name="Сопровождать клиента во время аренды"><bpmn:incoming>f_t8_t9</bpmn:incoming><bpmn:outgoing>f_t9_t10</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t10" name="Принять оборудование, проверить состояние"><bpmn:incoming>f_t9_t10</bpmn:incoming><bpmn:outgoing>f_t10_t11</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t11" name="Закрыть заказ в журнале"><bpmn:incoming>f_t10_t11</bpmn:incoming><bpmn:outgoing>f_t11_e</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e" name="Заказ выполнен"><bpmn:incoming>f_t11_e</bpmn:incoming></bpmn:endEvent>
